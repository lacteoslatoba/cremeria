{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm.cmd run tasks:*)",
      "Bash(npm.cmd run claude:*)",
      "Bash(npm.cmd run watch:claude:*)",
      "Bash(npm.cmd run lint:*)",
      "Bash(npm.cmd run dev:*)",
      "Bash(npm.cmd run build:*)",
      "Bash(npm.cmd run prisma:*)",
      "Bash(npm.cmd run db:generate:*)",
      "Bash(npm.cmd run db:studio:*)",
      "Bash(npm run tasks:*)",
      "Bash(npm run claude:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run prisma:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsx:*)",
      "Bash(npx next:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Read(**)",
      "Edit(**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(vercel:*)",
      "Bash(npm.cmd run db:*)",
      "Bash(npm run db:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npm.cmd run prisma -- migrate:*)",
      "Bash(npm.cmd install:*)",
      "Bash(npm.cmd i:*)",
      "Bash(npm.cmd uninstall:*)",
      "Bash(npm.cmd ci:*)",
      "Bash(npx playwright:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Read(./dev.db)",
      "Read(./*.pem)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(Remove-Item:*)",
      "Bash(del:*)",
      "Bash(rd:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npm.cmd run prisma -- migrate reset:*)",
      "Bash(vercel env:*)"
    ]
  }
}
