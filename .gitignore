# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# PWA — generado por @ducanh2912/next-pwa en cada build, no se versiona
/public/sw.js
/public/swe-worker*.js
/public/workbox-*.js
/public/sw.js.map
/public/workbox-*.js.map

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
nextdev.log
build.log
build.err.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# herramientas de agente (skills locales / locks) — no son parte de la app
/.agents
/.claude/*
# ...salvo la politica de permisos, que SI se comparte con el repo
!/.claude/settings.json
skills-lock.json

/src/generated/prisma
_cel_screen*.png
_*.js
_*.png
_*.map
nextdev_live.log
cel_capture.png

# restos de depuracion que se colaban por el patron _*.js
_*.mjs
_*.err
_*.out

# estado local del vigilante de agentes (cada maquina lleva el suyo)
docs/verifications/.ultimo-verificado
