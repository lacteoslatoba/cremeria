// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?
  username  String?  @unique
  password  String?
  address   String?
  mpCustomerId String?
  stripeCustomerId String?
  resetToken String?
  resetTokenExpiry DateTime?
  role      String   @default("CUSTOMER") // CUSTOMER, ADMIN or DELIVERY
  orders    Order[]
  deliveryOrders Order[] @relation("DeliveryOrders")
  savedCards SavedCard[]
  // Live GPS location, updated by the DELIVERY app while a route is active
  currentLat  Float?
  currentLng  Float?
  locationUpdatedAt DateTime?
  isOnline    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  price       Float
  stock       Int      @default(0)
  image       String?
  status      String   @default("ACTIVE") // ACTIVE or INACTIVE
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  mpPaymentId   String?     // Mercado Pago payment ID
  clipPaymentId String?     // Clip payment_request_id (checkout redireccionado)
  stripePaymentIntentId String? // Stripe PaymentIntent id
  conektaOrderId String?    // Conekta order id (POST /orders)
  paymentStatus String      @default("PENDING") // PENDING, APPROVED, REJECTED
  paymentMethod String      @default("CASH")    // CASH, STRIPE, CONEKTA (CARD/CLIP/MERCADOPAGO quedan solo por historial)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String?
  address       String
  total         Float
  status        String      @default("PENDING") // PENDING, PREPARING, OUT_FOR_DELIVERY, COMPLETED, CANCELLED
  deliveryId    String?
  delivery      User?       @relation("DeliveryOrders", fields: [deliveryId], references: [id])
  // Código de verificación de entrega: se genera al crear la orden y se envía
  // por SMS al cliente. El repartidor debe ingresarlo para poder marcar la
  // orden como COMPLETED (confirma que se entregó a la persona correcta).
  deliveryCode        String?
  deliveryCodeStatus  String?   // GENERATED | VERIFIED
  deliveryConfirmedAt DateTime?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // El cliente puede "eliminar" un pedido de su propia lista (Mis pedidos)
  // sin que se borre de verdad -- el admin lo sigue viendo entero para
  // reportes/contabilidad. No aplica a nada del lado del admin/repartidor.
  hiddenFromUser Boolean    @default(false)
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model SavedCard {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpCustomerId     String
  mpCardId         String
  lastFour         String
  cardBrand        String   // visa, master, amex, etc.
  expirationMonth  String
  expirationYear   String
  holderName       String
  createdAt        DateTime @default(now())
}
