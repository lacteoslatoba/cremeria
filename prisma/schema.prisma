// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?
  username  String?  @unique
  password  String?
  address   String?
  stripeCustomerId String?
  resetToken String?
  resetTokenExpiry DateTime?
  role      String   @default("CUSTOMER") // CUSTOMER, ADMIN or DELIVERY
  orders    Order[]
  deliveryOrders Order[] @relation("DeliveryOrders")
  // Live GPS location, updated by the DELIVERY app while a route is active
  currentLat  Float?
  currentLng  Float?
  locationUpdatedAt DateTime?
  isOnline    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índices: role para filtrar admins/repartidores; phone para búsquedas de
  // soporte. email/username ya tienen índice implícito por @unique.
  @@index([role])
  @@index([phone])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  price       Float
  stock       Int      @default(0)
  image       String?
  status      String   @default("ACTIVE") // ACTIVE or INACTIVE
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Índices: (status, stock) cubre el filtro principal de la tienda pública
  // (WHERE status='ACTIVE' AND stock > 0); category para el filtro de categoría.
  @@index([status, stock])
  @@index([category])
  @@index([status])
}

model Order {
  id            String      @id @default(cuid())
  stripePaymentIntentId String? @unique // Stripe PaymentIntent id
  paymentStatus String      @default("PENDING") // PENDING, APPROVED, REJECTED
  paymentMethod String      @default("CASH")    // CASH, STRIPE (CONEKTA/CARD/CLIP/MERCADOPAGO quedan solo por historial)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String?
  address       String
  total         Float
  status        String      @default("PENDING") // PENDING, PREPARING, OUT_FOR_DELIVERY, COMPLETED, CANCELLED
  deliveryId    String?
  delivery      User?       @relation("DeliveryOrders", fields: [deliveryId], references: [id])
  // Código de verificación de entrega: se genera al crear la orden y se envía
  // por SMS al cliente. El repartidor debe ingresarlo para poder marcar la
  // orden como COMPLETED (confirma que se entregó a la persona correcta).
  deliveryCode        String?
  deliveryCodeStatus  String?   // GENERATED | VERIFIED
  deliveryConfirmedAt DateTime?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // El cliente puede "eliminar" un pedido de su propia lista (Mis pedidos)
  // sin que se borre de verdad -- el admin lo sigue viendo entero para
  // reportes/contabilidad. No aplica a nada del lado del admin/repartidor.
  hiddenFromUser Boolean    @default(false)

  // Índices críticos para rendimiento a escala:
  // - userId: "Mis pedidos" filtra siempre por usuario
  // - status: el panel admin filtra por estado constantemente
  // - deliveryId: el repartidor consulta sus órdenes activas
  // - (status, createdAt): listados paginados del admin ordenados por fecha
  // - stripePaymentIntentId ya tiene @unique (implica índice)
  @@index([userId])
  @@index([status])
  @@index([deliveryId])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
